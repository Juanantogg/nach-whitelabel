# Dependencies
node_modules/
.pnpm-store/

# Build output
dist/
build/
*.tsbuildinfo

# Env
.env
.env.local
.env.*.local

# Material criptográfico local (generado por dev; nunca al repo). La privada va
# en .env; la pública se sirve por endpoint. Ver docs/seguridad.md.
*.pem

# Logs
*.log
npm-debug.log*
pnpm-debug.log*

# Coverage / test
coverage/

# Editor / OS
.DS_Store
.idea/
*.swp
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json

# Misc
.cache/

# Scratch local de assets de marca (la fuente vive en S3, ADR 13; solo el default
# va bundleado en frontend/public). No al repo.
.tmp-variantes/

# Playwright CLI — artefactos de sesión (snapshots, screenshots, logs)
.playwright-cli/
.playwright/

# Harness — índice de sesión efímero (la evidencia por feature SÍ se commitea)
progress/current.md

# Claude Code — settings locales del usuario (los del proyecto SÍ se versionan)
.claude/settings.local.json
