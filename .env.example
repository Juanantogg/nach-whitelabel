# ─── Backend ───────────────────────────────────────────────
PORT=3001
NODE_ENV=development

# MongoDB Atlas connection string
MONGODB_URI=mongodb+srv://<user>:<pass>@<cluster>/nach?retryWrites=true&w=majority

# Clave simétrica AES compartida (front y back deben coincidir).
# Genera una con: openssl rand -hex 32
CRYPTO_SECRET=replace_with_32_byte_hex

# ─── Frontend (Vite: solo variables con prefijo VITE_ se exponen) ───
VITE_API_URL=http://localhost:3001
VITE_CRYPTO_SECRET=replace_with_32_byte_hex
# Marca por defecto (white-label): shopinbaz | elektra
VITE_DEFAULT_BRAND=shopinbaz
