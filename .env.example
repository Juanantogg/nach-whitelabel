# ─── Backend ───────────────────────────────────────────────
PORT=3001
NODE_ENV=development

# MongoDB Atlas connection string
MONGODB_URI=mongodb+srv://<user>:<pass>@<cluster>/nach?retryWrites=true&w=majority

# Cifrado híbrido asimétrico: el backend guarda su clave PRIVADA (nunca sale de
# aquí) y sirve la pública en un endpoint. El front cifra con la pública, el back
# descifra con la privada. Ver docs/seguridad.md.
# Genera un par con:
#   openssl genpkey -algorithm RSA -pkeyopt rsa_keygen_bits:2048 -out private.pem
#   openssl pkey -in private.pem -pubout -out public.pem
# Pega el PEM en una sola línea con \n, o carga el archivo desde disco.
CRYPTO_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"

# ─── Frontend (Vite: solo variables con prefijo VITE_ se exponen) ───
# NOTA: el front NO lleva ninguna clave de cifrado. Obtiene la clave pública del
# backend en runtime; por diseño no hay secreto en el bundle.
VITE_API_URL=http://localhost:3001
# Marca por defecto (white-label): shopinbaz | elektra
VITE_DEFAULT_BRAND=shopinbaz
